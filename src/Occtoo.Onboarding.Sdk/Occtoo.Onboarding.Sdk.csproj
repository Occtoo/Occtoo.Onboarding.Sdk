<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
	<Title>Occtoo.Onboarding.Sdk</Title>
	<Company>Occtoo</Company>
	<Authors>Occtoo</Authors>
	<Description>Wrapped HttpClient for onboarding data to Occtoo</Description>
	<Copyright>Copyright © Occtoo AB 2023-</Copyright>
	<PackageTags>occtoo;onboarding</PackageTags>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageIcon>icon.png</PackageIcon>
	<PackageReadmeFile>readme.md</PackageReadmeFile>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<AssemblyVersion>3.1.0.0</AssemblyVersion>
	<FileVersion>3.1.0.0</FileVersion>
	<Version>3.1.0</Version>
	<PackageProjectUrl>https://github.com/Occtoo/Occtoo.Onboarding.Sdk</PackageProjectUrl>
	<RepositoryUrl>https://github.com/Occtoo/Occtoo.Onboarding.Sdk</RepositoryUrl>
	<PackageReleaseNotes>Fixes uploads failing with "A task was canceled." - the request timeout is now 5 minutes and configurable, retries are limited to transient failures, and Dispose no longer tears down the shared HttpClient.</PackageReleaseNotes>
  </PropertyGroup>
	
  <ItemGroup>
    <PackageReference Include="CSharpFunctionalExtensions" Version="3.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
    <PackageReference Include="System.Reactive" Version="6.*" />
  </ItemGroup>
	
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="6.0.*" />
		<PackageReference Include="System.Collections.Immutable" Version="6.0.*" />
		<PackageReference Include="Microsoft.Extensions.Http.Polly" Version="6.0.*" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.*" />
		<PackageReference Include="System.Collections.Immutable" Version="8.*" />
		<PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.*" />
	</ItemGroup>
  <ItemGroup>
    <Folder Include="images\" />
	<None Include="images\icon.png" Pack="true" PackagePath="\" />
	<None Include="docs\readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
